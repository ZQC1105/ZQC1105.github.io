## 八、实际应用场景

### **场景1：数据处理管道**
```typescript
import { pipe, group, sort, unique, mapValues } from 'radash'

const processUserData = (users: User[]) => pipe(
  users,
  // 1. 去重
  users => unique(users, u => u.id),
  // 2. 按部门分组
  users => group(users, u => u.dept),
  // 3. 每个部门内按年龄排序
  groups => mapValues(groups, users => sort(users, u => u.age)),
  // 4. 计算每个部门平均年龄
  groups => mapValues(groups, users => ({
    users,
    avgAge: average(users.map(u => u.age))
  }))
)
```

### **场景2：API 请求增强**
```typescript
import { tryit, retry, sleep } from 'radash'

const fetchWithRetry = async (url: string) => {
  // 先等待1秒
  await sleep(1000)
  
  // 失败重试3次
  const [error, data] = await tryit(
    retry({ times: 3 }, () => fetch(url))
  )()
  
  if (error) {
    console.error('最终失败:', error)
    return null
  }
  
  return data
}
```

### **场景3：表单数据处理**
```typescript
import { pick, omit, isNullOrEmpty } from 'radash'

const submitForm = (formData: any) => {
  // 1. 移除空字段
  const cleaned = omit(formData, (value) => isNullOrEmpty(value))
  
  // 2. 只取需要的字段
  const apiData = pick(cleaned, ['name', 'email', 'age'])
  
  // 3. 发送请求
  return api.post('/user', apiData)
}
```

## 九、Radash vs Lodash 对比

| 特性 | Radash | Lodash |
|------|--------|--------|
| **TypeScript** | ✅ 原生完美支持 | ❌ 需要额外类型 |
| **Tree-shaking** | ✅ 完美 | ⚠️ 部分支持 |
| **体积** | 小 (~5kb) | 大 (~70kb) |
| **API 设计** | 现代化、函数式 | 传统 |
| **学习曲线** | 平缓 | 较陡 |
| **流行度** | 新兴 | 成熟 |
| **C# LINQ 风格** | ✅ 相似 | ⚠️ 部分相似 |

## 十、最佳实践组合

### **Vue 3 + Radash + VueUse**
```typescript
import { ref, computed } from 'vue'
import { useLocalStorage } from '@vueuse/core'
import { unique, group, sort, tryit } from 'radash'

// 响应式数据 + 工具函数
const users = useLocalStorage<User[]>('users', [])

// 计算属性中使用 Radash
const processedUsers = computed(() => pipe(
  users.value,
  users => unique(users, u => u.id),
  users => group(users, u => u.role),
  groups => mapValues(groups, users => sort(users, u => u.name))
))

// 异步操作
const fetchUsers = async () => {
  const [error, data] = await tryit(api.get('/users'))()
  if (!error && data) {
    users.value = data
  }
}
```

